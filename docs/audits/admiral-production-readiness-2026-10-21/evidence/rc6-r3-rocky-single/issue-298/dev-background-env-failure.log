guest=rc6e99rocky-devnode
os=Rocky Linux 10.2 (Red Quartz)

service_environment=
[admiral-harbor.service]
Environment=ENV=development
EnvironmentFiles=/etc/admiral/harbor.env (ignore_errors=no)
EnvironmentFiles=/etc/admiral/harbor.smtp.env (ignore_errors=yes)
[admiral-harbor-worker.service]
Environment=ENV=production
EnvironmentFiles=/etc/admiral/harbor.env (ignore_errors=no)
EnvironmentFiles=/etc/admiral/harbor.smtp.env (ignore_errors=yes)
[admiral-harbor-catalog-sync.service]
Environment=ENV=production
EnvironmentFiles=/etc/admiral/harbor.env (ignore_errors=no)

nonsecret_dev_flags=
26:ADMIRAL_CA_FILE=
27:ADMIRAL_INSECURE_SKIP_VERIFY=1

