=== admiral-harbor-worker.service drop-in ===
# /usr/lib/systemd/system/admiral-harbor-worker.service
[Unit]
Description=Admiral Harbor reconciliation worker
Documentation=https://github.com/admiral-project/admiral
After=network-online.target admirald.service
Wants=network-online.target admirald.service

[Service]
Type=oneshot
EnvironmentFile=/etc/admiral/harbor.env
EnvironmentFile=-/etc/admiral/harbor.smtp.env
Environment=ENV=production
ExecStart=/usr/bin/python3 /usr/lib/admiral/harbor/worker.py
WorkingDirectory=/usr/lib/admiral/harbor
StandardOutput=journal
StandardError=journal
User=admiral
Group=admiral

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/admiral/harbor/uploads
CapabilityBoundingSet=
SystemCallArchitectures=native
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/admiral-harbor-worker.service.d/dev-mode.conf
[Service]
Environment=ENV=development
effective_environment=ENV=development
inactive

