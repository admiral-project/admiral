# Wrapper to add /usr/local site-packages to PYTHONPATH.
# Required because gunicorn is invoked with python3 -sP which
# excludes /usr/local/lib/python*/site-packages.

PYTHON_SITE=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
PYTHON_SITE64=$(python3 -c 'import sysconfig; print(sysconfig.get_path("platlib"))')
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}${PYTHON_SITE64}:${PYTHON_SITE}"
exec /usr/bin/gunicorn "$@"
