[Unit]
Description=Admiral Harbor reconciliation worker
Documentation=https://github.com/admiral-project/admiral
After=network-online.target admirald.service
Wants=network-online.target admirald.service

[Service]
Type=oneshot
EnvironmentFile=/etc/admiral/harbor.env
Environment=ENV=production
ExecStart=/usr/bin/python3 /usr/lib/admiral/harbor/worker.py
WorkingDirectory=/usr/lib/admiral/harbor
StandardOutput=journal
StandardError=journal
User=admiral
Group=admiral

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
CapabilityBoundingSet=
SystemCallArchitectures=native
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
