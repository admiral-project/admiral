[Unit]
Description=Admiral Control Plane
Documentation=https://github.com/admiral-project/admiral
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
ExecStart=/usr/bin/admirald
Restart=on-failure
RestartSec=10
Environment=ADMIRAL_TLS_CA_FILE=/etc/admiral/tls/ca.pem
StandardOutput=journal
StandardError=journal

# Runtime directories
ReadWritePaths=/var/lib/admiral /var/log/admiral

# User
User=admiral
Group=admiral

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
SystemCallArchitectures=native
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=true
RestrictRealtime=true
DevicePolicy=closed
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
