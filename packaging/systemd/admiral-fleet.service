[Unit]
Description=Admiral Fleet Worker Agent
Documentation=https://github.com/admiral-project/admiral
After=network-online.target systemd-machined.service
Wants=network-online.target systemd-machined.service

[Service]
Type=simple
ExecStart=/usr/bin/admiral-fleet
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/etc/admiral/fleet.env
Environment=ADMIRAL_SYSTEMD_TIMEOUT=300

# Runtime directories
ReadWritePaths=/etc/containers/systemd/admiral /var/lib/admiral /etc/containers/systemd/users /run/user

# Hardening
# Fleet must manage rootless users and Podman/systemd state, so it needs the
# capabilities below and cannot run with NoNewPrivileges enabled.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
SystemCallArchitectures=native
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
