[Unit]
Description=Admiral Fleet Worker Agent
Documentation=https://github.com/admiral-project/admiral
After=network-online.target systemd-machined.service
Wants=network-online.target systemd-machined.service

[Service]
Type=simple
Environment=ENV=production
ExecStart=/usr/bin/admiral-fleet
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=/etc/admiral/fleet.env
Environment=ADMIRAL_SYSTEMD_TIMEOUT=300
Environment=ENV=production
Environment=ADMIRAL_FLEET_ALLOWED_REGISTRIES=docker.io,quay.io,registry.redhat.io

# Runtime directories
ReadWritePaths=/etc/containers/systemd/admiral /var/lib/admiral /etc/containers/systemd/users /var/lib/admiral-apps /run/user

# Hardening
# Fleet must manage rootless users and Podman/systemd state, so it needs the
# capabilities below and cannot run with NoNewPrivileges enabled.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
SystemCallArchitectures=native
PrivateDevices=true
DevicePolicy=closed
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
