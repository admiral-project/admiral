[Unit]
Description=Admiral Customer Portal
Documentation=https://github.com/admiral-project/admiral
After=network-online.target admirald.service
Wants=network-online.target admirald.service

[Service]
Type=simple
EnvironmentFile=/etc/admiral/harbor.env
EnvironmentFile=-/etc/admiral/harbor.smtp.env
Environment=ENV=production
ExecStartPre=/usr/bin/harbor-migrate
ExecStart=/usr/bin/harbor-gunicorn --workers 2 --bind 127.0.0.1:5001 --certfile /etc/admiral/tls/admirald.pem --keyfile /etc/admiral/tls/admirald-key.pem run:app
WorkingDirectory=/usr/lib/admiral/harbor
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/admiral/harbor/uploads
CapabilityBoundingSet=
SystemCallArchitectures=native
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
LockPersonality=true
RestrictSUIDSGID=true
User=admiral
Group=admiral

[Install]
WantedBy=multi-user.target
