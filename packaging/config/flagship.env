# Admiral Flagship configuration
# Environment file sourced by admiral-flagship.service.
# The RPM installs this file as /etc/admiral/flagship.env.
# These values are safe defaults for local development and QA.
# Replace them before using the service in production.

FLAGSHIP_SECRET_KEY=__REQUIRED__
ADMIRAL_API_URL=https://127.0.0.1:8080
ADMIRAL_INTERNAL_TOKEN=__REQUIRED__
ADMIRAL_CA_FILE=
FLAGSHIP_SMTP_HOST=
FLAGSHIP_SMTP_PORT=587
FLAGSHIP_SMTP_STARTTLS=1
FLAGSHIP_SMTP_USERNAME=
FLAGSHIP_SMTP_PASSWORD=
FLAGSHIP_SMTP_FROM=
FLAGSHIP_TRUSTED_DEVICE_DAYS=30
FLAGSHIP_MFA_VERIFY_MAX_ATTEMPTS=5
FLAGSHIP_MFA_VERIFY_WINDOW_SECONDS=300
FLAGSHIP_MFA_RESEND_MAX_ATTEMPTS=5
FLAGSHIP_MFA_RESEND_WINDOW_SECONDS=3600
FLAGSHIP_MFA_RESEND_COOLDOWN_SECONDS=30
