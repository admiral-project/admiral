# Admiral Flagship configuration
# Environment file sourced by admiral-flagship.service.
# The RPM installs this file as /etc/admiral/flagship.env.
# These values are safe defaults for local development and QA.
# Replace them before using the service in production.

FLAGSHIP_SECRET_KEY=change-me
ADMIRAL_API_URL=https://127.0.0.1:8080
ADMIRAL_SHARED_TOKEN=dev-token
ADMIRAL_CA_FILE=
