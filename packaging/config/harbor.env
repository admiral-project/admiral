# Admiral Harbor configuration
# Environment file sourced by Admiral Harbor systemd units and harborctl.
# The RPM installs this file as /etc/admiral/harbor.env.
# These values are safe defaults for local development and QA.
# Replace them before using the service in production.

HARBOR_DATABASE_URL=__REQUIRED__
HARBOR_SECRET_KEY=__REQUIRED__
HARBOR_UPLOAD_DIR=/var/lib/admiral/harbor/uploads
HARBOR_MAX_BACKUP_UPLOAD_BYTES=536870912
HARBOR_ENCRYPTION_KEY=__REQUIRED__
HARBOR_PAYPAL_CLIENT_ID=__REQUIRED_IF_PAYPAL__
HARBOR_PAYPAL_CLIENT_SECRET=__REQUIRED_IF_PAYPAL__
HARBOR_PAYPAL_WEBHOOK_ID=__REQUIRED_IF_PAYPAL__
HARBOR_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
HARBOR_PAYPAL_MODE=sandbox
HARBOR_PAYPAL_RETURN_URL=https://localhost:5000/billing/return
HARBOR_PAYPAL_CANCEL_URL=https://localhost:5000/billing/cancel
HARBOR_SMTP_FROM=noreply@example.com
HARBOR_EXTERNAL_URL=https://localhost:5000
HARBOR_OVERDUE_POLICY_VERSION=overdue-policy-v1
HARBOR_OVERDUE_SUSPEND_AFTER_DAYS=5
HARBOR_OVERDUE_DEPROVISION_AFTER_DAYS=10
HARBOR_OVERDUE_LAST_BACKUP_RETENTION_DAYS=15
ADMIRAL_API_URL=https://127.0.0.1:8080
ADMIRAL_ADMIN_TOKEN=__REQUIRED__
ADMIRAL_CA_FILE=
ADMIRAL_INSECURE_SKIP_VERIFY=0
