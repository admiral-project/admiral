table inet admiral_egress {
    chain output {
        type filter hook output priority -5; policy accept;
        # Workloads all run as the dedicated rootless user. Never let one use
        # the worker's published-port range to reach another co-resident
        # tenant through loopback or the worker's WireGuard address.
        # Fleet and Caddy use different host identities, so their authorised
        # health checks and ingress proxying remain available.
        meta skuid "{{ fleet_rootless_user | default('admiral-apps') }}" ip daddr 127.0.0.1 tcp dport 40000-49999 reject
        meta skuid "{{ fleet_rootless_user | default('admiral-apps') }}" ip daddr 10.99.0.0/24 tcp dport 40000-49999 reject
        # Admiral deliberately uses a port-level node policy here. Docker Hub
        # and PayPal use DNS, CDNs, and rotating addresses; pinning their IPs
        # would make secure installs fail unpredictably. This follows the
        # Kubernetes model: node connectivity remains available while finer
        # workload policy is a separate concern.
        # References:
        # https://kubernetes.io/docs/concepts/services-networking/network-policies/
        # https://kubernetes.io/docs/concepts/cluster-administration/networking/
        oif lo accept
        ct state { established, related } accept
        ip daddr 10.99.0.0/24 accept
        # Correct time is security-critical for TLS, tokens, and audit records.
        udp dport 123 accept
{% if admiral_egress_ipv6_enabled | default(false) | bool %}
        # Permit the IPv6 control-plane neighbour discovery required for a
        # functional dual-stack host. The default does not add ICMPv6 policy.
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, echo-request, echo-reply } accept
{% endif %}
{% if admiral_effective_host_profile in ['single-node', 'admin'] %}
        # SMTP submission is required for Harbor and Flagship notifications.
        # S3-compatible backup endpoints such as MinIO commonly expose the
        # API on TCP/9000. HTTPS S3 endpoints continue to use TCP/443.
{% if (admiral_egress_ipv4_destinations | default([]) | length) > 0 %}
        ip daddr { {{ admiral_egress_ipv4_destinations | join(', ') }} } tcp dport { 22, 80, 443, 587, 9000, 53 } accept
{% else %}
        tcp dport { 22, 80, 443, 587, 9000, 53 } accept
{% endif %}
{% if (admiral_egress_ipv6_destinations | default([]) | length) > 0 %}
        ip6 daddr { {{ admiral_egress_ipv6_destinations | join(', ') }} } tcp dport { 22, 80, 443, 587, 9000, 53 } accept
{% endif %}
        udp dport 53 accept
{% else %}
        tcp dport 22 accept
        # DNS is required for registry and PayPal endpoint discovery. It is
        # intentionally port-based rather than tied to DHCP/static resolver
        # addresses; operators can add a destination-aware control later.
        tcp dport 53 accept
        udp dport 53 accept
        # HTTPS is required for OCI registries and PayPal APIs. Restricting
        # this to a static IP list is not reliable because both use CDNs.
        # Workers must reach the configured external backup store as well as
        # OCI registries and notification providers.
        # EL10 BaseOS/AppStream/CRB and EPEL may publish mirror URLs over
        # HTTP. Allow repository downloads without exposing TCP/80 inbound.
{% if (admiral_egress_ipv4_destinations | default([]) | length) > 0 %}
        ip daddr { {{ admiral_egress_ipv4_destinations | join(', ') }} } tcp dport { 80, 443, 587, 9000 } accept
{% else %}
        tcp dport { 80, 443, 587, 9000 } accept
{% endif %}
{% if (admiral_egress_ipv6_destinations | default([]) | length) > 0 %}
        ip6 daddr { {{ admiral_egress_ipv6_destinations | join(', ') }} } tcp dport { 80, 443, 587, 9000 } accept
{% endif %}
        udp dport 51820 accept
{% endif %}
        reject
    }
}
